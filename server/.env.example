DATABASE_URL="postgresql://user:password@host:5432/db"
GEMINI_API_KEY=""
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
# Optional
CLIENT_URL="http://localhost:5173"
PORT=5000
# Set to "production" in deployment (enables SameSite=None cookies + trust proxy)
NODE_ENV=development
# Optional — enables "Continue as guest" (Supabase anonymous auth). Without these,
# POST /auth/guest returns 503 and the rest of the app is unaffected.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
