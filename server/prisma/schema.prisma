// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js" // Changed from "prisma-client"
}

datasource db {
  provider = "postgresql"
}

// 1. Define the choices (Enums)
enum PlanType {
  CUTTING
  BULKING
  RECOMP
}

enum Gender {
  MALE
  FEMALE
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

// 2. Define the main data table
model DietaryConstraint {
  id          String     @id @default(uuid())
  planType    PlanType
  gender      Gender
  unitSystem  UnitSystem
  height      Float // Use Float for decimals (e.g., 175.5 cm)
  weight      Float
  age         Int
  preferences String[] // An array of strings for things like "Vegan", "No Nuts"

  // Link back to the User
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Diet {
  id       String   @id @default(uuid())
  type     String
  portion  String
  meal     String
  calories Float
  carb     Float
  protein  Float
  fat      Float
  date     DateTime

  //Link back to DietPlan
  dietPlanId String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id])
}

model DietPlan {
  id            String   @id @default(uuid())
  date          DateTime
  diets         Diet[]
  totalCalories Float
  totalProtein  Float
  totalFat      Float
  totalCarbs    Float

  //Link back to the User
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model User {
  id           String              @id @default(uuid())
  email        String              @unique
  username     String?
  password     String
  refreshToken String?
  constraints  DietaryConstraint[]
  dietPlan     DietPlan[]
}
