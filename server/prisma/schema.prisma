// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Define the choices (Enums)
enum PlanType {
  CUTTING
  BULKING
  RECOMP
}

enum Gender {
  MALE
  FEMALE
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// 2. Define the main data tables
model DietaryConstraint {
  id          String     @id @default(uuid())
  planType    PlanType
  gender      Gender
  unitSystem  UnitSystem
  height      Float
  weight      Float
  age         Int
  preferences String

  // Strict 1-to-1 link back to User
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Diet {
  id         String   @id @default(uuid())
  mealType   MealType @default(BREAKFAST)
  portion    String
  meal       String
  calories   Float
  carb       Float
  protein    Float
  fat        Float

  // Link back to DietPlan
  dietPlanId String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dietPlanId])
}

model DietPlan {
  id            String   @id @default(uuid())
  date          DateTime
  diets         Diet[]
  totalCalories Float
  totalProtein  Float
  totalFat      Float
  totalCarbs    Float

  // Link back to the User
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
}

model WeightEntry {
  id        String   @id @default(uuid())
  weight    Float
  date      DateTime @default(now())
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model MealLog {
  id         String   @id @default(uuid())
  date       DateTime
  mealType   MealType
  name       String
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  adhered    Boolean  @default(true)
  dietPlanId String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, date])
}

model Measurement {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  chest     Float?
  waist     Float?
  hips      Float?
  arms      Float?
  thighs    Float?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model MealFeedback {
  id        String   @id @default(uuid())
  foodName  String
  rating    Int
  reason    String?
  isBlocked Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, foodName])
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  username      String?
  password      String?
  refreshToken  String?
  constraint    DietaryConstraint?
  dietPlan      DietPlan[]
  weightEntries WeightEntry[]
  mealLogs      MealLog[]
  measurements  Measurement[]
  mealFeedbacks MealFeedback[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}
